{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for TokenTool",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$TEMP/*" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$TEMP/*" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$TEMP/*" }]
    },
    "drag:default"
  ]
}
